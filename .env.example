# =============================================================================
# DRISHTI AI — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env to the repository.
# =============================================================================

# --- LLM Provider ---
LLM_PROVIDER=openai                     # openai | anthropic | custom
LLM_MODEL=gpt-4o                        # primary model
LLM_API_KEY=sk-your-key-here            # REQUIRED — never commit this
LLM_FALLBACK_MODEL=gpt-4o-mini          # secondary / cheaper model
LLM_MODE=live                           # live | record | replay

# --- Database ---
MONGODB_URI=mongodb://mongo:27017/drishti

# --- Artifacts ---
ARTIFACT_DIR=/data/artifacts

# --- Security ---
OPERATOR_PRIVATE_ALLOWLIST=shoplite      # hosts allowed despite private addresses

# --- ShopLite ---
SHOPLITE_BUG_SET=all                     # all | none | B1,B2,B3 (comma-separated)
SHOPLITE_PORT=3001

# --- Runner ---
MAX_PARALLEL_CONTEXTS=1                  # 1 for MVP (sequential)

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- Backend ---
BACKEND_PORT=8000
