<%- include('header', { title: 'Forgot Password', session: session }) %>

<div style="max-width: 440px; margin: 2rem auto;">
  <div class="card">
    <h1 style="font-size: 1.75rem; margin-bottom: 0.5rem; text-align: center;">Reset Password</h1>
    <p style="color: var(--text-muted); font-size: 0.9rem; text-align: center; margin-bottom: 1.5rem;">
      Enter your account email to receive a password reset link.
    </p>

    <div id="reset-success" class="alert alert-success" style="display: none;">
      If that account exists, a reset link has been sent.
    </div>

    <form id="reset-form">
      <div class="form-group">
        <label for="reset-email">Email Address</label>
        <input type="email" id="reset-email" name="email" placeholder="you@example.com" required>
      </div>

      <button type="submit" id="reset-submit-btn" style="width: 100%; margin-top: 0.5rem;">
        Send Reset Link
      </button>
    </form>

    <p style="text-align: center; color: var(--text-muted); font-size: 0.85rem; margin-top: 1.5rem;">
      Remembered your password? <a href="/login" id="link-back-login" style="color: var(--primary);">Back to Login</a>
    </p>
  </div>
</div>

<script>
document.getElementById('reset-form').addEventListener('submit', (e) => {
  e.preventDefault();
  document.getElementById('reset-success').style.display = 'block';
  document.getElementById('reset-form').reset();
});
</script>

<%- include('footer') %>
