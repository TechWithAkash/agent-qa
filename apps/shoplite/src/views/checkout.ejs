<%- include('header', { title: 'Checkout', session: session }) %>

<div style="max-width: 700px; margin: 1rem auto;">
  <h1 style="font-size: 2rem; margin-bottom: 1.5rem;">Checkout</h1>

  <div class="card" style="margin-bottom: 1.5rem;">
    <h2 style="font-size: 1.25rem; margin-bottom: 1rem;">Order Summary</h2>

    <!-- If items is null (triggered by B8), reading items.length or items.forEach will throw TypeError! -->
    <% items.forEach(function(item) { %>
      <div style="display: flex; justify-content: space-between; margin-bottom: 0.5rem; font-size: 0.95rem;">
        <span><%= item.product ? item.product.name : 'Item' %> × <%= item.quantity %></span>
        <span>$<%= item.product ? (item.product.price * item.quantity).toFixed(2) : '0.00' %></span>
      </div>
    <% }); %>

    <div style="border-top: 1px solid var(--border); margin: 1rem 0; padding-top: 1rem;">
      <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem;">
        <input type="text" id="coupon-input" placeholder="Promo code (e.g. SAVE10)" style="max-width: 250px;">
        <button type="button" id="apply-coupon-btn" class="btn btn-secondary" onclick="applyCoupon()">
          Apply
        </button>
      </div>
      <div id="coupon-msg" style="font-size: 0.85rem; margin-bottom: 0.5rem; display: none;"></div>

      <div style="display: flex; justify-content: space-between; color: var(--text-muted); margin-bottom: 0.25rem;">
        <span>Subtotal</span>
        <span id="summary-subtotal">$<%= subtotal ? subtotal.toFixed(2) : '0.00' %></span>
      </div>

      <div style="display: flex; justify-content: space-between; color: var(--success); margin-bottom: 0.25rem;">
        <span>Discount</span>
        <span id="summary-discount">-$<%= discount ? discount.toFixed(2) : '0.00' %></span>
      </div>

      <div style="display: flex; justify-content: space-between; font-size: 1.25rem; font-weight: 700; color: #fff; margin-top: 0.75rem; border-top: 1px solid var(--border); padding-top: 0.75rem;">
        <span>Total</span>
        <span id="summary-total">$<%= total ? total.toFixed(2) : '0.00' %></span>
      </div>
    </div>

    <button type="button" id="place-order-btn" class="btn" style="width: 100%; margin-top: 1rem; font-size: 1.1rem; padding: 0.8rem;" onclick="placeOrder()">
      Place Order
    </button>
  </div>
</div>

<script>
let currentSubtotal = <%= subtotal || 0 %>;
let currentDiscount = <%= discount || 0 %>;

async function applyCoupon() {
  const code = document.getElementById('coupon-input').value.trim();
  const msg = document.getElementById('coupon-msg');
  msg.style.display = 'none';

  try {
    const res = await fetch('/api/checkout/apply-coupon', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ coupon: code, subtotal: currentSubtotal })
    });
    const data = await res.json();
    if (res.ok) {
      msg.textContent = 'Coupon applied successfully!';
      msg.style.color = 'var(--success)';
      msg.style.display = 'block';

      currentDiscount += parseFloat(data.discount);
      document.getElementById('summary-discount').textContent = '-$' + currentDiscount.toFixed(2);
      document.getElementById('summary-total').textContent = '$' + (currentSubtotal - currentDiscount).toFixed(2);
    } else {
      msg.textContent = data.error || 'Invalid coupon';
      msg.style.color = 'var(--danger)';
      msg.style.display = 'block';
    }
  } catch (e) {
    msg.textContent = 'Error applying coupon';
    msg.style.color = 'var(--danger)';
    msg.style.display = 'block';
  }
}

async function placeOrder() {
  const btn = document.getElementById('place-order-btn');
  btn.disabled = true;
  btn.textContent = 'Processing...';

  try {
    const res = await fetch('/api/checkout/place-order', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' }
    });
    const data = await res.json();
    if (res.ok && data.redirect) {
      window.location.href = data.redirect;
    } else {
      alert(data.error || 'Failed to place order');
      btn.disabled = false;
      btn.textContent = 'Place Order';
    }
  } catch (e) {
    alert('Server error during checkout');
    btn.disabled = false;
    btn.textContent = 'Place Order';
  }
}
</script>

<%- include('footer') %>
