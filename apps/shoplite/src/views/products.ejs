<%- include('header', { title: 'Products', session: session }) %>

<div style="margin-bottom: 2rem; display: flex; flex-wrap: wrap; gap: 1rem; align-items: center; justify-content: space-between;">
  <div>
    <h1 style="font-size: 2rem; margin-bottom: 0.25rem;">Explore Products</h1>
    <p style="color: var(--text-muted); font-size: 0.95rem;">Find the best items curated for you.</p>
  </div>

  <form id="search-form" action="/products" method="GET" style="display: flex; gap: 0.5rem; max-width: 360px; width: 100%;">
    <input type="text" id="search-input" name="q" value="<%= query || '' %>" placeholder="Search products (e.g. coffee)...">
    <button type="submit" id="search-btn" class="btn">Search</button>
  </form>
</div>

<% if (query) { %>
  <div style="margin-bottom: 1.5rem; color: var(--text-muted);">
    Showing results for "<strong style="color: #fff;"><%= query %></strong>"
    <a href="/products" style="color: var(--primary); margin-left: 0.75rem; text-decoration: none; font-size: 0.9rem;">Clear</a>
  </div>
<% } %>

<% if (products.length === 0) { %>
  <div class="card" style="text-align: center; padding: 3rem 1rem;">
    <p style="font-size: 2.5rem; margin-bottom: 0.5rem;">🔍</p>
    <h3 style="margin-bottom: 0.5rem;">No products found</h3>
    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem;">Try adjusting your search terms or browse our full catalog.</p>
    <a href="/products" class="btn btn-secondary">View All Products</a>
  </div>
<% } else { %>
  <div class="grid" id="product-list">
    <% products.forEach(function(product) { %>
      <div class="card product-card" id="product-card-<%= product.id %>">
        <div class="product-image"><%= product.image %></div>
        <h3 style="font-size: 1.15rem; margin-bottom: 0.25rem;">
          <a href="/products/<%= product.id %>" style="color: inherit; text-decoration: none;">
            <%= product.name %>
          </a>
        </h3>
        <p style="color: var(--text-muted); font-size: 0.85rem; text-transform: capitalize; margin-bottom: 1rem;">
          Category: <%= product.category %>
        </p>
        <div style="margin-top: auto; display: flex; align-items: center; justify-content: space-between;">
          <span style="font-size: 1.25rem; font-weight: 700; color: #fff;">$<%= product.price.toFixed(2) %></span>
          <button class="btn btn-sm add-to-cart-btn" id="add-to-cart-<%= product.id %>" onclick="addToCart('<%= product.id %>')">
            Add to Cart
          </button>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<script>
async function addToCart(productId) {
  try {
    const res = await fetch('/api/cart/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ productId, quantity: 1 })
    });
    const data = await res.json();
    if (res.ok) {
      alert('Product added to cart!');
    } else {
      alert(data.error || 'Could not add to cart');
    }
  } catch (e) {
    alert('Error adding product to cart');
  }
}
</script>

<%- include('footer') %>
